{
  "name": "radha-naam-jap",
  "version": "1.0.0",
  "private": true,
  "description": "Radha Naam Jap - Panchanga / mala counter app (Capacitor Android wrapper)",
  "scripts": {
    "www": "bash setup-www.sh",
    "sync": "bash setup-www.sh && npx cap sync android",
    "open:android": "npx cap open android",
    "build:apk": "bash build-android.sh",
    "build:apk:keep": "bash build-android.sh --keep",
    "build:apk:release": "bash setup-www.sh && npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^6.0.1",
    "@capacitor-firebase/authentication": "^6.3.0",
    "@capacitor-firebase/messaging": "^6.3.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.2",
    "@capacitor/background-runner": "^2.3.1",
    "@capacitor/browser": "^6.0.3",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/geolocation": "^6.0.1",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/share": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
